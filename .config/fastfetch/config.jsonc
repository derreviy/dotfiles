{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small" },
  "display": { "percent": { "type": 3 } },
  "modules": [
    "title",
    { "type": "custom", "format": "----------------------------------------" },
    { "type": "os", "keyColor": "35" },
    { "type": "kernel", "keyColor": "35" },
    { "type": "uptime", "keyColor": "35" },
    { "type": "packages", "keyColor": "35" },
    { "type": "custom", "format": "----------------------------------------" },
    { "type": "shell", "keyColor": "33" },
    { "type": "wm", "keyColor": "33" },
    { "type": "terminal", "keyColor": "33" },
    { "type": "custom", "format": "----------------------------------------" },
    { "type": "cpu", "keyColor": "36" },
    { "type": "gpu", "keyColor": "36" },
    { "type": "memory", "keyColor": "32" },
    { "type": "disk", "keyColor": "32" },
    { "type": "custom", "format": "----------------------------------------" },
    "colors"
  ]
}
